<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- Root element -->
  <xsd:element name="courses">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="course" type="CourseType" minOccurs="1" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- Course type definition -->
  <xsd:complexType name="CourseType">
    <xsd:sequence>
      <xsd:element name="title"      type="xsd:string"/>
      <xsd:element name="category"   type="xsd:string"/>
      <xsd:element name="instructor" type="xsd:string"/>
      <xsd:element name="price"      type="xsd:positiveInteger"/>
      <xsd:element name="rating"     type="RatingType"/>
      <xsd:element name="duration"   type="xsd:string"/>
      <xsd:element name="students"   type="xsd:nonNegativeInteger"/>
    </xsd:sequence>
  </xsd:complexType>

  <!-- Rating restricted to 0.0 – 5.0 -->
  <xsd:simpleType name="RatingType">
    <xsd:restriction base="xsd:decimal">
      <xsd:minInclusive value="0.0"/>
      <xsd:maxInclusive value="5.0"/>
      <xsd:fractionDigits value="1"/>
    </xsd:restriction>
  </xsd:simpleType>

</xsd:schema>
